// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String
  avatarKey    String?

  // 🔹 Stripe + Credits
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  credits              Int     @default(0)
  isAdmin              Boolean @default(false)

  // 🔹 Entitlements (RP-010 Phase 1)
  // Schema-only foundation for the Plan / Custom Minutes / Free Probe model.
  // No runtime code reads or writes these fields yet — enforcement lands in
  // later phases (Entitlement Resolver, Stripe lifecycle, Probe logic).
  plan                 Plan      @default(FREE)
  planPeriodStart      DateTime?
  planPeriodEnd        DateTime?
  probeGenerationsUsed Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Job       Job[]
  tracks    Track[]
  stories   Story[]
  playlists Playlist[]

  preferenceProfile UserPreferenceProfile?
  periodUsages      PeriodUsage[]
  libraryUnlocks    LibraryUnlock[]
}

model UserPreferenceProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Structured fields (all optional — users may fill in any subset)
  primaryGoal             String? // sleep | stress_relief | focus | relaxation | comfort | other
  preferredTone           String? // very_soft | calm | neutral | immersive
  pacing                  String? // very_slow | slow | medium
  preferredFormats        String[] @default([]) // ["sleep-story","meditation","classic-asmr","kids-story"]
  likedThemes             String[] @default([])
  dislikedThemes          String[] @default([])
  voicePreference         String? // female | male | no_preference
  directAddressPreference String? // yes | no | subtle
  contentBoundaries       String[] @default([])
  emotionalContext        String?
  desiredOutcome          String?

  // Narrative summary suitable for LLM prompt injection (server-derived; user never edits directly).
  summaryMarkdown String?

  // Raw onboarding answers (free-form JSON) — kept so we can re-derive
  // structured fields if the questionnaire schema evolves.
  onboardingAnswers Json?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  prompt      String
  preset      String?
  language    String?
  status      JobStatus @default(QUEUED)
  resultUrl   String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  durationSec Int?
  voiceStyle      String  @default("soft") // "soft" | "whisper"
  voiceGender     String  @default("female") // "female" | "male"
  scriptOverride  String?

  // Narrative preset mode. MVP UI submits "story" only; "quiet-knowledge"
  // remains a valid persisted value for post-MVP reactivation.
  narrativeMode   String?

  // Credit-refund audit fields
  // ttsStartedAt    — persisted immediately before the first ElevenLabs call.
  //                   NULL means TTS was never attempted for this job.
  //                   Survives serverless function crashes; used by both the
  //                   /complete failure paths and the stale-recovery GET handler
  //                   to decide whether a credit refund is appropriate.
  // creditRefundedAt — set atomically (inside a transaction) the moment a refund
  //                   is issued. Acts as an idempotency gate: no second refund can
  //                   be issued once this is non-NULL, even across concurrent requests
  //                   or function retries.
  ttsStartedAt     DateTime?
  creditRefundedAt DateTime?

  // Entitlement usage audit (RP-010 Phase 1)
  // Written by later-phase runtime code (reservation / finalize / release).
  // Nullable so all existing Jobs remain valid; no backfill in this phase.
  entitlementKind  EntitlementKind?
  reservedMinutes  Int?
  usageFinalizedAt DateTime?
  usageReleasedAt  DateTime?

  // Stable mapping to the PeriodUsage row a PLAN_MINUTES reservation was
  // debited against (RP-010 Phase 3B). Set at reservation time so finalize
  // can move minutes back against the *original* period even after the
  // user's billing period has rolled over. Nullable — pre-Phase-3B Jobs and
  // all non-PLAN_MINUTES Jobs leave it null. onDelete: SetNull because the
  // Job row must outlive any accidental PeriodUsage deletion.
  periodUsageId    String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      Track[]
  periodUsage PeriodUsage? @relation(fields: [periodUsageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status])
  @@index([periodUsageId])
}

model Story {
  id         String   @id @default(cuid())
  userId     String
  title      String
  preset     String   @default("sleep-story")
  language   String?
  scriptText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks Track[]

  @@index([userId, createdAt])
}

model Track {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  title           String
  url             String
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job  Job? @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public Sharing
  isPublic  Boolean @default(false)
  shareSlug String? @unique

  // ✅ Album / Kapitel
  storyId   String?
  partIndex Int? // 1..N (oder 0..N-1, aber konsistent)
  partTitle String?
  story     Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  scriptText String?

  playlistItems PlaylistItem[]

  // Optional aber sehr hilfreich: Reihenfolge eindeutig
  @@unique([storyId, partIndex])
  @@index([userId, createdAt])
  @@index([jobId])
  @@index([storyId, partIndex])
}

model Preset {
  id                 String   @id @default(cuid())
  slug               String   @unique
  label              String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  defaultDurationSec Int?
}

model Playlist {
  id        String         @id @default(cuid())
  userId    String
  name      String
  pinned    Boolean        @default(false)
  position  Int            @default(0)
  coverKey  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, pinned, position])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

// Entitlement plan tier (RP-010 Phase 1).
// FREE users receive lifetime probe generations and daily Library unlocks only.
// STARTER / PREMIUM users receive Custom Minutes per billing period.
enum Plan {
  FREE
  STARTER
  PREMIUM
}

// Which entitlement bucket a Job draws from (RP-010 Phase 1).
// PLAN_MINUTES → paid Custom Minutes (STARTER / PREMIUM).
// PROBE        → one of the two lifetime Free probe generations.
enum EntitlementKind {
  PLAN_MINUTES
  PROBE
}

// Per-billing-period usage accumulator for STARTER / PREMIUM users.
// One row per (user, periodStart). Written by later-phase runtime logic
// (reservation and finalization); nothing reads or writes it in this phase.
model PeriodUsage {
  id              String   @id @default(cuid())
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  minutesUsed     Int      @default(0)
  minutesReserved Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
}

// Source of a LibraryUnlock row (RP-010 Phase 2A).
// Only SPONSORED is defined: FREE users obtain per-session Library access by
// completing a Sponsored Unlock. Paid plans (STARTER / PREMIUM) never create
// LibraryUnlock rows — their access is resolved directly from User.plan by
// later-phase runtime logic.
enum LibraryUnlockSource {
  SPONSORED
}

// Curated Library Session (RP-010 Phase 2A).
// An independent root entity: not owned by a User and unrelated to Job,
// Track, Story or Playlist. Represents an editorially curated multi-chapter
// audio session that FREE users unlock per-session and paid users access
// directly via their plan. Schema-only in this phase — no catalog API,
// no player wiring, no seed data.
model LibrarySession {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  preset          String
  durationSeconds Int?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chapters LibrarySessionChapter[]
  unlocks  LibraryUnlock[]

  @@index([isActive])
}

// Ordered chapter belonging to exactly one LibrarySession (RP-010 Phase 2A).
// audioKey is persisted metadata only in this phase — no S3 access is
// implemented and chapters are intentionally not linked to existing Track,
// Job or Story rows.
model LibrarySessionChapter {
  id               String   @id @default(cuid())
  librarySessionId String
  partIndex        Int
  title            String?
  audioKey         String
  durationSeconds  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  librarySession LibrarySession @relation(fields: [librarySessionId], references: [id], onDelete: Cascade)

  @@unique([librarySessionId, partIndex])
}

// Per-user, per-session unlock record (RP-010 Phase 2A).
// One row per successful Sponsored Unlock. A single user may unlock the same
// LibrarySession multiple times over its lifetime (once each expiry lapses);
// active-unlock reuse is enforced later in runtime logic, not by a unique
// constraint. Intentionally does NOT reference Probe Generations, Credits,
// Jobs, Tracks, Stories, Purchases or paid Plan access.
model LibraryUnlock {
  id               String              @id @default(cuid())
  userId           String
  librarySessionId String
  unlockedAt       DateTime            @default(now())
  expiresAt        DateTime
  source           LibraryUnlockSource
  providerEventId  String?             @unique
  createdAt        DateTime            @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  librarySession LibrarySession @relation(fields: [librarySessionId], references: [id], onDelete: Cascade)

  @@index([userId, unlockedAt])
  @@index([userId, librarySessionId, expiresAt])
}
